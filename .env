# MongoDB Local Configuration - REAL TRANSACTIONS (Port 27018)
MONGODB_URI=mongodb://127.0.0.1:27018/cat_modeling_dev?replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/cat_modeling_test?replicaSet=rs0

# Server Configuration
PORT=3001
NODE_ENV=development

# Mock Database - DISABLED (using real MongoDB transactions)
USE_MOCK_DB=false

# API Configuration  
API_VERSION=v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info
